DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# openssl rand -base64 48
AUTH_SECRET=

# Public address without a trailing slash
SITE_URL=https://animeb.ge

# Set to 1 only behind Nginx that sets X-Real-IP
TRUST_PROXY=1

# Absolute path to the host's uploads folder (cards, avatars, clubs...)
UPLOADS_DIR=/var/www/animeb.ge/uploads

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
